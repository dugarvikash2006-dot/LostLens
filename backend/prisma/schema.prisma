// LostLens — Prisma schema
// Phase 2B: database foundation only. No business logic, auth, or scoring
// happens here — this schema just models the data future phases will use.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum ReportType {
  LOST
  FOUND
}

enum Category {
  ELECTRONICS
  ACCESSORIES
  BAGS
  DOCUMENTS
  KEYS
  CLOTHING
  BOOKS
  OTHER
}

enum ReportStatus {
  OPEN
  POTENTIAL_MATCH
  CLAIM_PENDING
  RETURNED
  CLOSED
  // Phase 8: the terminal "happy path" state — the reporter confirmed
  // they got the item back. Added rather than reusing RETURNED/CLOSED
  // so existing data/behavior tied to those values is untouched.
  REUNITED
}

// Phase 8: optional, reporter-supplied context for how a reunion came
// about — purely informational (analytics/product-feedback), never
// read by any matching or ranking logic.
enum ReunionMethod {
  AI_MATCH
  CONTACTED_ME
  MANUAL_SEARCH
  CAMPUS_SECURITY
  FRIEND
}

enum MatchStatus {
  SUGGESTED
  REVIEWING
  ACCEPTED
  REJECTED
}

enum ClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  COMPLETED
}

enum NotificationType {
  NEW_MATCH
  CLAIM_RECEIVED
  CLAIM_APPROVED
  CLAIM_REJECTED
  ITEM_RETURNED
  REPORT_UPDATED
}

// ------------------------------------------------------------------------
// User
// ------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  // Placeholder for a future bcrypt hash. Not populated with real
  // authentication logic in this phase.
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  itemReports   ItemReport[]
  claims        Claim[]
  notifications Notification[]

  @@map("users")
}

// ------------------------------------------------------------------------
// ItemReport — a single LOST or FOUND report
// ------------------------------------------------------------------------

model ItemReport {
  id                  String       @id @default(cuid())
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  reportType          ReportType
  itemName            String
  category            Category
  brand               String?
  color               String?
  description         String
  distinctiveFeatures String?

  eventDate           DateTime
  // Free-text approximate time (e.g. "around 3 PM") rather than an exact
  // timestamp, since reporters rarely know the precise time.
  approximateTime     String?

  location            String
  locationDetails     String?

  // Phase 7: where a FOUND item can currently be picked up (e.g. "Library
  // Reception"). Left null for LOST reports and unused there — the API
  // only accepts it on the FOUND creation endpoint, but it lives on the
  // shared model rather than a separate one, same as the other
  // report-type-specific optional fields above (approximateTime, etc).
  currentLocation     String?

  // Phase 7: optional contact details so another user viewing this report
  // (LOST or FOUND) can reach the reporter directly. All three are
  // independently optional — a reporter may give only a phone, only an
  // email, both, or neither.
  contactName         String?
  contactPhone        String?
  contactEmail        String?

  // Optional for now; storage/upload (e.g. Cloudinary) is a later phase.
  // Keeping this as a plain URL string lets that be swapped in later
  // without a schema change.
  imageUrl            String?

  status              ReportStatus @default(OPEN)
  // Phase 8: when this report's status became REUNITED. Null until then.
  reunitedAt          DateTime?
  // Phase 8: optional, only ever set alongside/after REUNITED — see
  // ReunionMethod above.
  reunionMethod       ReunionMethod?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // A report can appear in many candidate matches, either as the lost
  // side or the found side.
  lostMatches  Match[] @relation("LostItemMatches")
  foundMatches Match[] @relation("FoundItemMatches")

  // Phase 3C: 0-5 Cloudinary-hosted images per report. The legacy
  // `imageUrl` field above is left untouched (still nullable, unused
  // going forward) rather than removed, to avoid an unnecessary
  // destructive migration — this additive relation is the smallest
  // change that supports multiple images per report.
  images ReportImage[]

  // Milestone 3A: embeddings generated at upload time (before this
  // report exists) that later got linked to this report, if any.
  imageEmbeddings ReportImageEmbedding[]

  @@index([userId])
  @@index([reportType])
  @@index([category])
  @@index([status])
  @@index([eventDate])
  @@index([location])
  @@index([createdAt])
  @@map("item_reports")
}

// ------------------------------------------------------------------------
// ReportImage — Cloudinary-hosted images attached to an ItemReport
// ------------------------------------------------------------------------

model ReportImage {
  id       String     @id @default(cuid())
  reportId String
  report   ItemReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  // Only the Cloudinary URL and public ID are stored — never binary
  // image data.
  imageUrl String
  publicId String

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("report_images")
}

// ------------------------------------------------------------------------
// ReportImageEmbedding — OpenCLIP embedding for an uploaded image
// ------------------------------------------------------------------------
//
// Milestone 3A: storage only. No similarity search, ranking, or automatic
// matching reads this table yet — those are later milestones.
//
// `reportId` is nullable because embeddings are generated immediately
// after an image is uploaded (POST /api/items/upload), which happens
// before any ItemReport exists — reports are only created in a separate,
// later request. This row is linked to a report if/when that image is
// later included in a LOST/FOUND report submission; wiring up that link
// is out of scope for this milestone.
//
// `embedding` is a plain Float[] rather than a pgvector column: Prisma 7
// has no native vector scalar type. The only way to touch a pgvector
// column at all is the `postgresqlExtensions` preview feature plus
// `Unsupported("vector(n)")`, and any `Unsupported`-typed field is
// entirely excluded from the generated Client's type-safe API — every
// read and write would need hand-written raw SQL, which every other
// model in this codebase avoids. Float[] is fully supported, fully
// typed, and sufficient for storage-only; a future milestone that
// actually needs similarity search can add a pgvector-backed column then.
model ReportImageEmbedding {
  id String @id @default(cuid())

  reportId String?
  report   ItemReport? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  publicId String @unique
  imageUrl String

  embedding          Float[]
  embeddingDimension Int
  // Identifies which OpenCLIP checkpoint produced this vector (e.g.
  // "ViT-B-32/laion2b_s34b_b79k") — reported by the AI service itself
  // rather than hardcoded here, so it always reflects whatever model
  // actually generated this specific embedding.
  modelName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@map("report_image_embeddings")
}

// ------------------------------------------------------------------------
// Match — a candidate pairing between one LOST and one FOUND report
// ------------------------------------------------------------------------

model Match {
  id           String @id @default(cuid())

  lostItemId   String
  lostItem     ItemReport @relation("LostItemMatches", fields: [lostItemId], references: [id], onDelete: Cascade)

  foundItemId  String
  foundItem    ItemReport @relation("FoundItemMatches", fields: [foundItemId], references: [id], onDelete: Cascade)

  // Similarity scores are populated by a future AI matching phase.
  // Nullable for now since no scoring happens yet.
  overallScore     Decimal? @db.Decimal(5, 2)
  imageScore       Decimal? @db.Decimal(5, 2)
  descriptionScore Decimal? @db.Decimal(5, 2)
  categoryScore    Decimal? @db.Decimal(5, 2)
  locationScore    Decimal? @db.Decimal(5, 2)
  dateScore        Decimal? @db.Decimal(5, 2)

  status      MatchStatus @default(SUGGESTED)
  explanation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims Claim[]

  // A given lost/found pair should only ever have one candidate match row.
  @@unique([lostItemId, foundItemId])
  @@index([status])
  @@index([createdAt])
  @@map("matches")
}

// ------------------------------------------------------------------------
// Claim — an ownership verification attempt against a Match
// ------------------------------------------------------------------------

model Claim {
  id          String @id @default(cuid())

  matchId     String
  match       Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  claimantId  String
  claimant    User   @relation(fields: [claimantId], references: [id], onDelete: Restrict)

  distinctiveMarkAnswer String
  contentsAnswer        String
  serialNumber          String?
  additionalEvidence    String?
  proofImageUrl         String?

  status    ClaimStatus @default(SUBMITTED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([matchId])
  @@index([claimantId])
  @@index([status])
  @@map("claims")
}

// ------------------------------------------------------------------------
// Notification
// ------------------------------------------------------------------------

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String
  isRead  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}
