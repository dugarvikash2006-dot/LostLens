# Server
PORT=5000
NODE_ENV=development

# CORS
# Comma-separated list of allowed origins (e.g. your frontend's dev URL)
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL via Prisma)
# Replace with your real local/remote PostgreSQL connection string.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/lostlens?schema=public"

# Authentication (JWT)
# Use a long, random, secret value in real environments — never reuse this
# placeholder. For example: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
