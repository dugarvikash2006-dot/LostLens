# Server
PORT=5000
NODE_ENV=development

# CORS
# A single allowed origin (e.g. your frontend's dev URL). Only one origin
# is supported — this value is passed directly to the `cors` middleware's
# `origin` option, which is not split on commas.
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL via Prisma)
# Replace with your real local/remote PostgreSQL connection string.
DATABASE_URL="postgresql://USERNAME:PASSWORD@HOST:5432/lostlens?schema=public"

# Authentication (JWT)
# Use a long, random, secret value in real environments — never reuse this
# placeholder. For example: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Image uploads (Cloudinary)
# Get these from your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=replace_with_your_cloud_name
CLOUDINARY_API_KEY=replace_with_your_api_key
CLOUDINARY_API_SECRET=replace_with_your_api_secret
